---
const skillGroups = [
  {
    label: 'Infrastructure as Code',
    items: ['Terraform', 'Ansible'],
  },
  {
    label: 'CI/CD',
    items: ['GitLab CI/CD', 'GitHub Actions'],
  },
  {
    label: 'AWS',
    items: ['RDS', 'FSx', 'ECS', 'WAF', 'EC2', 'EFS'],
  },
  {
    label: 'Observability',
    items: ['Wazuh', 'Grafana', 'Prometheus', 'OpenTelemetry'],
  },
];
---

<section id="skills" class="reveal border-b border-zinc-800/60 px-6 py-24">
  <div class="mx-auto max-w-3xl">
    <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-amber-400"><span class="font-mono text-zinc-600">02</span>Skills</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {skillGroups.map((group) => (
        <div>
          <h3 class="mb-3 text-sm font-medium text-zinc-300">{group.label}</h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-full border border-zinc-700 px-3 py-1 text-sm text-zinc-200">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
