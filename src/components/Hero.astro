---
---

<section class="flex min-h-[80vh] items-center border-b border-zinc-800/60 px-6 py-16">
  <div class="mx-auto grid max-w-5xl items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="mb-4 text-sm font-medium uppercase tracking-widest text-amber-400">
        Lead Cloud Developer
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Hi, I'm Md Zahirul Islam.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-200">
        I automate and scale multi-account AWS platforms in high-availability,
        regulated environments — 8+ years running infrastructure on Terraform,
        GitLab CI/CD, and Ansible. On the side, I build indie mobile apps under 
        <a href="https://rawbuild.de" target="_blank" rel="noopener" class="text-amber-400 hover:underline">rawbuild.de</a>.
      </p>

      <dl class="mt-8 grid grid-cols-3 gap-4 border-y border-zinc-800 py-5 text-center sm:max-w-md sm:text-left">
        <div>
          <dt class="text-xs uppercase tracking-wide text-zinc-500">Experience</dt>
          <dd class="mt-1 text-xl font-semibold text-white">8+ yrs</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-zinc-500">Customer systems</dt>
          <dd class="mt-1 text-xl font-semibold text-white">400+</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-zinc-500">Incident effort cut</dt>
          <dd class="mt-1 text-xl font-semibold text-white">70%</dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#contact"
          class="rounded-md bg-amber-500 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-amber-400"
        >
          Get in touch
        </a>
        <a
          href="/resume.pdf"
          download
          class="rounded-md border border-zinc-700 px-5 py-2.5 text-sm font-semibold text-zinc-200 transition hover:border-zinc-500 hover:text-white"
        >
          Download CV
        </a>
      </div>
    </div>

    <div class="hidden font-mono text-sm lg:block">
      <div class="overflow-hidden rounded-lg border border-zinc-800 bg-black shadow-xl shadow-black/40">
        <div class="flex items-center gap-1.5 border-b border-zinc-800 bg-zinc-900 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          <span class="ml-2 text-xs text-zinc-500">zsh</span>
        </div>
        <div class="space-y-1.5 px-5 py-5 text-zinc-300">
          <p><span class="text-amber-400">$</span> terraform plan</p>
          <p class="text-zinc-500">Refreshing state... 400+ resources</p>
          <p><span class="text-emerald-400">+</span> aws_ecs_service.platform</p>
          <p><span class="text-emerald-400">+</span> aws_rds_cluster.tenant_db</p>
          <p class="text-zinc-500">Plan: 2 to add, 0 to change, 0 to destroy.</p>
          <p class="mt-3"><span class="text-amber-400">$</span> terraform apply -auto-approve</p>
          <p class="text-emerald-400">Apply complete! Resources: 2 added.</p>
          <p class="mt-3"><span class="text-amber-400">$</span> <span class="animate-pulse">_</span></p>
        </div>
      </div>
    </div>
  </div>
</section>
